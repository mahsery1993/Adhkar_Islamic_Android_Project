<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:padding="16dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="زاد الذاكرين - الأذكار والمنبه الذكي"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#064E3B"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switchEnableReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل الإشعارات التذكيرية المنبثقة"
            android:textSize="16sp"
            android:checked="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تحديد وقت ظهور الإشعار:"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerInterval"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الأذكار المشمولة في التنبيه (6 أقسام):"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/chkMorning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☀️ أذكار الصباح"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkEvening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌙 أذكار المساء"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkJawami"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ جوامع الأذكار والأدعية الجامعة"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkPrayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕌 أذكار بعد الصلاة المفروضة"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛌 أذكار النوم"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkRuqyah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ الرقية الشرعية من القرآن والسنة"
            android:checked="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الإعدادات وتفعيل المنبه"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTestNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تجربة الإشعار المنبثق الآن"
            android:backgroundTint="#D97706"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تصفية عرض الأذكار حسب القسم:"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerCategoryFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAdhkarList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp"
            android:textColor="#1E293B"
            android:padding="12dp"
            android:background="#FFFFFF" />

    </LinearLayout>
</ScrollView>
